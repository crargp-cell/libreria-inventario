// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS - 5 roles
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  passwordHash String
  role      String   @default("vendedor") // superadmin | admin | supervisor | encargado | vendedor
  status    String   @default("active")  // active | inactive | deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Relaciones
  createdOrders     Order[]       @relation("OrderCreatedBy")
  createdRestocks   RestockRequest[] @relation("RestockCreatedBy")
  approvedRestocks  RestockRequest[] @relation("RestockApprovedBy")
  auditLogs         AuditLog[]    @relation("AuditLogUser")
  transactions      Transaction[]
  stockRequests      StockRequest[] @relation("RequestRequester")
  reviewedRequests   StockRequest[] @relation("RequestReviewer")
  cancelledRequests  StockRequest[] @relation("RequestCanceller")
  dispatchesMade     Dispatch[]     @relation("DispatchBy")
  dispatchesReceived Dispatch[]     @relation("DispatchReceiver")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ============================================
// CATEGORÍAS DE INVENTARIO
// ============================================
model Category {
  id    String @id @default(cuid())
  name  String @unique
  description String?
  status String @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  inventoryItems InventoryItem[]

  @@index([name])
  @@index([status])
}

// ============================================
// INVENTARIO - Stock de libros/productos
// ============================================
model InventoryItem {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String?
  image         String?  // Imagen de referencia del producto (base64 o URL)
  categoryId    String
  quantity      Int      @default(0)    // stock total en piezas (unidad mínima de venta)
  unitsPerPack  Int      @default(1)    // piezas por caja/paquete (1 = se vende solo suelto)
  packName      String?                 // Caja | Paquete | Docena | Bolsa ...
  minStockLevel Int      @default(10)
  unitPrice     Float
  supplier      String?  // marca / fabricante
  // Atributos del inventario generalizado: agrupan productos equivalentes sin importar la marca
  genericName   String?  // p. ej. "Bolígrafo"
  color         String?
  size          String?
  model         String?
  presentation  String?
  status        String   @default("in_stock") // in_stock | low_stock | out_of_stock
  lastRestocked DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderLineItems OrderLineItem[]
  restockRequests RestockRequest[]
  requestItems    StockRequestItem[]
  dispatchItems   DispatchItem[]

  @@index([categoryId])
  @@index([code])
  @@index([status])
}

// ============================================
// PEDIDOS/ÓRDENES DE VENTA
// ============================================
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  total       Float    @default(0)
  status      String   @default("pending") // pending | processing | completed | cancelled
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  createdBy   User? @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems   OrderLineItem[]

  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model OrderLineItem {
  id              String @id @default(cuid())
  orderId         String
  inventoryItemId String?
  quantity        Int
  unitPrice       Float
  createdAt       DateTime @default(now())

  // Relaciones
  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([inventoryItemId])
}

// ============================================
// RESTOCK - Solicitudes de reabastecimiento
// ============================================
model RestockRequest {
  id                String   @id @default(cuid())
  inventoryItemId   String
  quantityRequested Int
  status            String   @default("pending") // pending | approved | rejected | completed
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy         User @relation("RestockCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy        User? @relation("RestockApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([status])
  @@index([createdById])
}

// ============================================
// AUDITORÍA - Registro de todas las acciones
// ============================================
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // CREATE | READ | UPDATE | DELETE | LOGIN | LOGOUT | APPROVE | REJECT | COMPLETE
  entityType  String   // USER | INVENTORY_ITEM | ORDER | RESTOCK_REQUEST | TRANSACTION
  entityId    String
  userId      String
  changes     String?  // JSON serialized as string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relaciones
  user        User @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// TRANSACCIONES - Registro por caja/cajero
// ============================================
model Transaction {
  id          String   @id @default(cuid())
  type        String   // sale | refund | adjustment | payment
  userId      String
  amount      Float
  description String?
  metadata    String?  // JSON serialized as string
  createdAt   DateTime @default(now())

  // Relaciones
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// REPORTES - Métricas y estadísticas
// ============================================
model DailyMetric {
  id              String   @id @default(cuid())
  date            DateTime
  totalSales      Float    @default(0)
  totalOrders     Int      @default(0)
  lowStockItems   Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([date])
  @@index([date])
}

// ============================================
// SOLICITUDES AL ALMACÉN Y DESPACHOS
// El stock solo se descuenta al registrar un despacho.
// ============================================
model StockRequest {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  status        String    @default("pending") // pending | approved | partially_dispatched | dispatched | rejected | cancelled
  requesterId   String
  note          String?
  reviewerId    String?
  reviewNote    String?
  reviewedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requester   User               @relation("RequestRequester", fields: [requesterId], references: [id])
  reviewer    User?              @relation("RequestReviewer", fields: [reviewerId], references: [id])
  cancelledBy User?              @relation("RequestCanceller", fields: [cancelledById], references: [id])
  items       StockRequestItem[]
  dispatches  Dispatch[]

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model StockRequestItem {
  id              String  @id @default(cuid())
  requestId       String
  inventoryItemId String
  // Copia de los datos del producto al momento de pedirlo (trazabilidad)
  productName     String
  productCode     String
  brand           String?
  details         String? // color, tamaño, modelo, presentación
  requestedQty    Int
  approvedQty     Int?
  dispatchedQty   Int     @default(0)

  request       StockRequest   @relation(fields: [requestId], references: [id])
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  dispatchItems DispatchItem[]

  @@unique([requestId, inventoryItemId])
  @@index([inventoryItemId])
}

model Dispatch {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement())
  requestId      String
  type           String   // venta | reposicion
  dispatchedById String
  receivedById   String
  note           String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  request      StockRequest   @relation(fields: [requestId], references: [id])
  dispatchedBy User           @relation("DispatchBy", fields: [dispatchedById], references: [id])
  receivedBy   User           @relation("DispatchReceiver", fields: [receivedById], references: [id])
  items        DispatchItem[]

  @@index([requestId])
  @@index([type])
  @@index([createdAt])
  @@index([dispatchedById])
  @@index([receivedById])
}

model DispatchItem {
  id              String @id @default(cuid())
  dispatchId      String
  requestItemId   String
  inventoryItemId String
  quantity        Int
  stockBefore     Int
  stockAfter      Int

  dispatch      Dispatch         @relation(fields: [dispatchId], references: [id])
  requestItem   StockRequestItem @relation(fields: [requestItemId], references: [id])
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id])

  @@index([dispatchId])
  @@index([requestItemId])
  @@index([inventoryItemId])
}
